# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key-minimum-32-chars

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/shah-international

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=Shah International <noreply@shahintl.com>

# WhatsApp
WHATSAPP_NUMBER=+8801700000000

# Currency API (https://openexchangerates.org - free plan available)
OPEN_EXCHANGE_RATES_APP_ID=your-open-exchange-rates-app-id

# Admin
SUPER_ADMIN_EMAIL=admin@shahintl.com

# Cron Job (for currency update + inventory alerts)
CRON_SECRET=your-cron-secret-key-minimum-32-chars

# Optional: Vercel Cron / external cron URL
# Schedule: GET /api/cron/update-currency with Authorization: Bearer <CRON_SECRET>
# Now wired up automatically via vercel.json (daily at 06:00 UTC — Vercel's Hobby plan rejects any
# cron schedule more frequent than once/day at deploy time, so this stays compatible on every plan).
# On Pro or higher you can safely tighten the schedule in vercel.json, e.g. "0 * * * *" for hourly.

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Web Push Notifications (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:admin@shahintl.com
